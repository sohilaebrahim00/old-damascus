# ============================================================
# OLD DAMASCUS MEDITERRANEAN RESTAURANT — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.local and fill in all values.
# Never commit .env.local to version control.

# ---- Site / App URL ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase ----
# REQUIRED. Without a reachable project: no accounts, no order persistence,
# no order confirmation page, no admin dashboards, no lead capture.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# REQUIRED for server writes. Without it the server falls back to the anon
# key and RLS blocks order reads/updates, stranding paid orders as UNPAID.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Clover Integration ----
CLOVER_ENV=production
CLOVER_MERCHANT_ID=
CLOVER_ACCESS_TOKEN=
NEXT_PUBLIC_CLOVER_PUBLIC_TOKEN=
CLOVER_PRIVATE_TOKEN=
CLOVER_PICKUP_ORDER_TYPE_ID=
CLOVER_DELIVERY_ORDER_TYPE_ID=
# Without this, webhook signature verification is skipped entirely.
CLOVER_WEBHOOK_SECRET=

# Master switch for live card checkout.
NEXT_PUBLIC_ENABLE_LIVE_CHECKOUT=true

# ---- Email (Resend) ----
# Order confirmations and restaurant alerts stay silent until these are set.
RESEND_API_KEY=
# Must be a domain verified in Resend. The default onboarding@resend.dev
# sender only delivers to the Resend account owner.
RESEND_FROM_EMAIL="Old Damascus <orders@olddamascustx.com>"
ADMIN_NOTIFICATION_EMAIL=
CONTACT_RECIPIENT_EMAIL=info@olddamascustx.com
CATERING_RECIPIENT_EMAIL=info@olddamascustx.com

# ---- Analytics (optional) ----
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
